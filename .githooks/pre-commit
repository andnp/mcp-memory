#!/bin/sh
set -eu

worktree_root="$(git rev-parse --show-toplevel)"
cd "$worktree_root"

staged_py_files="$(git diff --cached --name-only --diff-filter=ACMR -- '*.py')"

if [ -z "$staged_py_files" ]; then
    printf 'No staged Python files; skipping ruff/pyright.\n'
    exit 0
fi

printf 'Running pre-commit checks on staged Python files from %s\n' "$worktree_root"
printf '%s\n' "$staged_py_files" | xargs uv run ruff check
printf '%s\n' "$staged_py_files" | xargs uv run pyright
